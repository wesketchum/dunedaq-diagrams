        <mxCell id="totals" parent="1" style="text;html=1;overflow=fill;strokeColor=none;fillColor=none;align=left;verticalAlign=top;" value="&lt;table border=&quot;1&quot; cellpadding=&quot;4&quot; style=&quot;border-collapse:collapse;width:100%;height:100%;font-size:12px;&quot;&gt;&lt;tr&gt;&lt;th align=&quot;left&quot;&gt;BDE totals&lt;/th&gt;&lt;th&gt;Per 27U rack&lt;/th&gt;&lt;th&gt;40 racks&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;WIECs (6 WIB + 1 PTC each)&lt;/td&gt;&lt;td align=&quot;center&quot;&gt;2&lt;/td&gt;&lt;td align=&quot;center&quot;&gt;80&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;PTCs&lt;/td&gt;&lt;td align=&quot;center&quot;&gt;2&lt;/td&gt;&lt;td align=&quot;center&quot;&gt;80&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;WIBs&lt;/td&gt;&lt;td align=&quot;center&quot;&gt;12&lt;/td&gt;&lt;td align=&quot;center&quot;&gt;480&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;10G data links (2 per WIB)&lt;/td&gt;&lt;td align=&quot;center&quot;&gt;24&lt;/td&gt;&lt;td align=&quot;center&quot;&gt;960&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Active data fibers&lt;/td&gt;&lt;td align=&quot;center&quot;&gt;48&lt;/td&gt;&lt;td align=&quot;center&quot;&gt;1920&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;MTP12 pigtails, WIEC to 27U panel&lt;/td&gt;&lt;td align=&quot;center&quot;&gt;4&lt;/td&gt;&lt;td align=&quot;center&quot;&gt;160&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;MTP12 data trunks to DAQ barracks (12 active)&lt;/td&gt;&lt;td align=&quot;center&quot;&gt;4&lt;/td&gt;&lt;td align=&quot;center&quot;&gt;160&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;1G Ctrl ports on aggregating switch (12 WIB + 2 PTC)&lt;/td&gt;&lt;td align=&quot;center&quot;&gt;14&lt;/td&gt;&lt;td align=&quot;center&quot;&gt;560&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Timing splitter outputs used by BDE (1 per PTC)&lt;/td&gt;&lt;td align=&quot;center&quot;&gt;2&lt;/td&gt;&lt;td align=&quot;center&quot;&gt;80&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;SM timing fibers, splitter to PTC&lt;/td&gt;&lt;td align=&quot;center&quot;&gt;2&lt;/td&gt;&lt;td align=&quot;center&quot;&gt;80&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;100G uplinks, readout switch to server&lt;/td&gt;&lt;td align=&quot;center&quot;&gt;2&lt;/td&gt;&lt;td align=&quot;center&quot;&gt;80&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;BDE readout switches&lt;/td&gt;&lt;td align=&quot;center&quot;&gt;-&lt;/td&gt;&lt;td align=&quot;center&quot;&gt;9&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;BDE TPC readout servers (4x100G inputs, 2 racks each)&lt;/td&gt;&lt;td align=&quot;center&quot;&gt;1 per 2&lt;/td&gt;&lt;td align=&quot;center&quot;&gt;20&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" vertex="1">
