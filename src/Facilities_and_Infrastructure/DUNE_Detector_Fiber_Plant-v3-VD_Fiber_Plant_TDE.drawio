        <mxCell id="legend" parent="1" style="text;html=1;whiteSpace=wrap;overflow=fill;strokeColor=#000000;fillColor=none;align=left;verticalAlign=top;" value="&lt;table cellpadding=&quot;4&quot; style=&quot;border-collapse:collapse;width:100%;height:100%;font-size:12px;&quot;&gt;&lt;tr&gt;&lt;th colspan=&quot;2&quot; align=&quot;left&quot;&gt;Colour = who purchases&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;background:#D5E8D4;border:1px solid #82B366;width:40px;&quot;&gt;&lt;/td&gt;&lt;td&gt;TDE&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;background:#DAE8FC;border:1px solid #6C8EBF;&quot;&gt;&lt;/td&gt;&lt;td&gt;DAQ&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;background:#FFD6E7;border:1px solid #D6336C;&quot;&gt;&lt;/td&gt;&lt;td&gt;FDC I&amp;amp;I&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td colspan=&quot;2&quot;&gt;Thick arrows: fiber trunks. Thin solid: patch / copper. Thin dashed: coax.&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" vertex="1">
